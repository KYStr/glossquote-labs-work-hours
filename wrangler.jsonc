{
  "name": "glossquote-labs-work-hours",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "hours.glossquote.com", "custom_domain": true }],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  }
}
